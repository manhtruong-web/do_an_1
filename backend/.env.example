APP_NAME=SmartMart AI
DEBUG=false
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/SmartMartAI?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
DATABASE_QUERY_TIMEOUT_SECONDS=15
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
VISUAL_SEARCH_VISION_ENABLED=false
ADMIN_API_TOKEN=

DATASET_DIR=../dataset/GroceryStoreDataset/dataset
FAISS_INDEX_DIR=../faiss_index
IMAGE_SEARCH_TOP_K=10
VISUAL_SEARCH_BATCH_SIZE=16
VISUAL_SEARCH_MODEL=ViT-B-32
VISUAL_SEARCH_PRETRAINED=laion2b_s34b_b79k
MAX_IMAGE_SIZE_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
